<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        >
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_margin="8dp"
                android:src="@drawable/arrow_left_circle_outline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/editTextFirstName"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVENT INFORMATION"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/backButton"
                app:layout_constraintBottom_toBottomOf="@id/backButton"
                app:layout_constraintEnd_toEndOf="parent"/>


            <!-- Text Input for First Name -->
            <EditText
                android:id="@+id/editTextFirstName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="First Name"
                app:layout_constraintTop_toBottomOf="@id/backButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/editTextLastName"
                android:layout_margin="8dp"/>

            <!-- Text Input for Last Name -->
            <EditText
                android:id="@+id/editTextLastName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Last Name"
                app:layout_constraintTop_toBottomOf="@id/backButton"
                app:layout_constraintStart_toEndOf="@id/editTextFirstName"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"/>

            <!-- Text Input for Address -->
            <EditText
                android:id="@+id/editTextAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Event Address"
                app:layout_constraintBottom_toTopOf="@id/editTextDate"
                app:layout_constraintTop_toBottomOf="@id/editTextFirstName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="8dp"/>

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter date of event (MMDDYY)"
                app:layout_constraintBottom_toTopOf="@id/editTextDescription"
                app:layout_constraintTop_toBottomOf="@id/editTextAddress"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"/>

            <EditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="What is your event about?"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLines="20"
                android:minLines="6"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toTopOf="@id/timeTitle"
                app:layout_constraintTop_toBottomOf="@id/editTextDate"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"/>

            <EditText
                android:id="@+id/editTextHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Hour"
                app:layout_constraintBottom_toTopOf="@id/typeTitle"
                app:layout_constraintTop_toBottomOf="@id/timeTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"/>

            <EditText
                android:id="@+id/editTextMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Min"
                app:layout_constraintBottom_toTopOf="@id/editTextHours"
                app:layout_constraintTop_toBottomOf="@id/editTextHours"
                app:layout_constraintStart_toEndOf="@id/editTextHours"
                android:layout_margin="8dp"/>

            <TextView
                android:id="@+id/timeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What time is your event?"
                android:textSize="18sp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/editTextDescription"
                app:layout_constraintBottom_toTopOf="@id/editTextHours"
                app:layout_constraintStart_toStartOf="parent"/>


            <Spinner
                android:id="@+id/spinnerAMPM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:layout_constraintStart_toEndOf="@id/editTextMinutes"
                app:layout_constraintTop_toTopOf="@id/editTextMinutes"
                app:layout_constraintBottom_toBottomOf="@id/editTextMinutes"
                />

            <TextView
                android:id="@+id/typeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What type of event is it?"
                android:textSize="18sp"
                android:layout_margin="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/editTextHours"
                />

            <Spinner
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@id/typeTitle"
                app:layout_constraintStart_toStartOf="parent"/>


            <EditText
                android:id="@+id/editTextReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Why are you interested in the event?"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLines="20"
                android:minLines="6"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toTopOf="@id/finishButton"
                app:layout_constraintTop_toBottomOf="@id/typeTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="8dp"/>


            <Button
                android:id="@+id/finishButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE EVENT"
                android:layout_marginVertical="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>