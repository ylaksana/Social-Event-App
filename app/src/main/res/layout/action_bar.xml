<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <ImageView
        android:id="@+id/profileButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/account"
        android:layout_margin="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mapButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <ImageView
        android:id="@+id/mapButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_margin="10dp"
        android:src="@drawable/map_search_outline"
        app:layout_constraintStart_toEndOf="@id/profileButton"
        app:layout_constraintEnd_toStartOf="@id/createButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/createButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_margin="10dp"
        android:src="@drawable/plus_box_outline"
        app:layout_constraintStart_toEndOf="@id/mapButton"
        app:layout_constraintEnd_toStartOf="@id/searchButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/searchButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:src="@drawable/cog"
        android:layout_margin="10dp"
        app:layout_constraintStart_toEndOf="@id/createButton"
        app:layout_constraintEnd_toStartOf="@id/eventListButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/eventListButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_margin="10dp"
        android:src="@drawable/notebook_outline"
        app:layout_constraintStart_toEndOf="@id/searchButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>