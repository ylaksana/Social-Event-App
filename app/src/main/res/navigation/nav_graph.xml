<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!--Home Fragment-->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.apfinalproject.ui.HomeFragment">

        <!--Navigation to other fragments-->

        <!--Home to OneEvent-->
        <action
            android:id="@+id/action_homeFragment_to_oneEventFragment"
            app:destination="@id/oneEventFragment" />

        <!--Home to CreateEvent-->
        <action
            android:id="@+id/action_homeFragment_to_createEventFragment"
            app:destination="@id/createEventFragment" />

        <!--Home to ChatList-->
        <action
            android:id="@+id/action_homeFragment_to_chatListFragment"
            app:destination="@id/chatListFragment" />

        <!--Home to Profile-->
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <!--Home to Edit Profile-->
        <action
            android:id="@+id/action_homeFragment_to_profileEditFragment"
            app:destination="@id/profileEditFragment" />

<!--        Home to New User-->
        <action
            android:id="@+id/action_homeFragment_to_newUserFragment"
            app:destination="@id/newUserFragment" />

        <!--Home to Settings-->
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

        <!--Home to Event List-->
        <action
            android:id="@+id/action_homeFragment_to_eventListFragment"
            app:destination="@id/eventListFragment" />

        <!--Home to Map-->
        <action
            android:id="@+id/action_homeFragment_to_mapFragment"
            app:destination="@id/mapFragment" />

        </fragment>

    <!--OneEvent Fragment-->
    <fragment
        android:id="@+id/oneEventFragment"
        android:name="com.example.apfinalproject.ui.OneEvent">

        <!--OneEvent to Profile-->
        <action
            android:id="@+id/action_oneEventFragment_to_profileFragment"
            app:destination="@id/profileFragment"/>

        <!--OneEvent to CreateEvent-->
        <action
            android:id="@+id/action_oneEventFragment_to_createEventFragment"
            app:destination="@id/createEventFragment"/>

        <argument
            android:name="Event"
            app:argType="com.example.apfinalproject.event.Event" />

    </fragment>

    <!--New User Fragment-->
    <fragment
        android:id="@+id/newUserFragment"
        android:name="com.example.apfinalproject.user.NewUserFragment">

        <!--NewUser to Home-->
        <action
            android:id="@+id/action_newUserFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <argument
            android:name="authUser"
            app:argType="com.google.firebase.auth.FirebaseUser" />

    </fragment>


    <!--createEvent Fragment-->
    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.example.apfinalproject.ui.CreateEventFragment">

        <!--CreateEvent to OneEvent-->
        <action
            android:id="@+id/action_createEventFragment_to_oneEventFragment"
            app:destination="@id/oneEventFragment" />

    </fragment>



    <!--Chat List Fragment-->
    <fragment
        android:id="@+id/chatListFragment"
        android:name="com.example.apfinalproject.ui.ChatListFragment" >

        <!--ChatList to Chat-->
        <action
            android:id="@+id/action_chatListFragment_to_chatFragment"
            app:destination="@id/chatFragment" />

    </fragment>

<!--    Chat Fragment-->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.apfinalproject.ui.ChatFragment">

        <argument
            android:name="Conversation"
            app:argType="com.example.apfinalproject.chat.Conversation"/>

    </fragment>


    <!--Map Fragment-->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.apfinalproject.ui.MapFragment">

        <!--Map to OneEvent-->
    <action
        android:id="@+id/action_mapFragment_to_oneEventFragment"
        app:destination="@id/oneEventFragment" />

    </fragment>



    <!--Profile Fragment-->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.apfinalproject.user.ProfileFragment" >

        <!--Profile to EditProfile-->
        <action
            android:id="@+id/action_profileFragment_to_profileEditFragment"
            app:destination="@id/profileEditFragment" />

    </fragment>

    <!--Profile Edit Fragment-->
    <fragment
        android:id="@+id/profileEditFragment"
        android:name="com.example.apfinalproject.user.ProfileEditFragment" >

        <!--EditProfile to Profile-->
        <action
            android:id="@+id/action_profileEditFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

    </fragment>



    <!--Settings Fragment-->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.apfinalproject.ui.SettingsFragment" />



    <!--EventList Fragment-->
    <fragment
        android:id="@+id/eventListFragment"
        android:name="com.example.apfinalproject.ui.EventListFragment">

        <!--EventList to Event-->
        <action
            android:id="@+id/action_homeFragment_to_oneEventFragment"
            app:destination="@id/oneEventFragment" />

    </fragment>


</navigation>