<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/eventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textSize="24sp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintBottom_toTopOf="@id/eventLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eventTime" />

        <TextView
            android:id="@+id/eventDescription"
            android:text="This is the TextView Containing the Event Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="6"
            android:textSize="12sp"
            android:padding="6dp"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eventLocation" />

        <TextView
            android:id="@+id/eventDate"
            android:text="00/00/0000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/timeDot"
            app:layout_constraintBottom_toTopOf="@id/eventTitle" />

        <TextView
            android:id="@+id/timeDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/eventDate"
            app:layout_constraintEnd_toStartOf="@id/eventTime"
            app:layout_constraintTop_toTopOf="@id/eventDate"
            app:layout_constraintBottom_toBottomOf="@id/eventDate"
            />

        <TextView
            android:id="@+id/eventTime"
            android:text="00:00"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginLeft="8dp"
            app:layout_constraintStart_toEndOf="@id/timeDot"
            app:layout_constraintTop_toTopOf="@id/eventDate"
            app:layout_constraintBottom_toBottomOf="@id/eventDate" />

        <TextView
            android:id="@+id/eventLocation"
            android:text="Event Location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/eventTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/miles"
            />

        <TextView
            android:id="@+id/miles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 mi"
            android:textSize="12sp"
            android:layout_marginHorizontal="8dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eventLocation"
            app:layout_constraintBottom_toTopOf="@id/eventDescription"
            />

        <TextView
            android:id="@+id/locationDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/eventDate"
            app:layout_constraintEnd_toStartOf="@id/eventTime"
            app:layout_constraintTop_toTopOf="@id/eventDate"
            app:layout_constraintBottom_toBottomOf="@id/eventDate"
            />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@id/eventDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />




    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>